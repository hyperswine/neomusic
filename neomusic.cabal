cabal-version: 3.0
name:           neomusic
version:        0.1.0.0
synopsis:       Algebraic music notation: .neomusic scores to audio, MIDI and piano sheets
description:    Please see the README on GitHub at <https://github.com/hyperswine/neomusic#readme>
homepage:       https://github.com/hyperswine/neomusic#readme
bug-reports:    https://github.com/hyperswine/neomusic/issues
author:         Jasen Qin
maintainer:     jasen.qin33@gmail.com
copyright:      2025 Jasen Qin
license:        GPL-3.0-only
license-file:   LICENSE
build-type:     Simple
extra-source-files:
    README.md
    docs/2026-09-22-NEOMUSIC-LANGUAGE.md
    docs/2026-10-21-NEOMUSIC-COMPOSITION.md
    docs/2026-10-24-NEOMUSIC-PIANO-AND-GUITARS.md
    docs/2026-10-27-NEOMUSIC-ACOUSTIC-INSTRUMENTS.md
    docs/2026-10-27-LAST-TRAIN-BLUE-HOUR.md
    examples/neomusic/*.neomusic
    examples/neomusic/audio/*.mp3
    examples/neomusic/acoustic/*.sfz
    examples/neomusic/acoustic/*.py
    examples/neomusic/acoustic/*.json
    examples/neomusic/acoustic/README.md
    test/golden/neomusic/*.ly
    test/golden/regression/*.neomusic
    test/golden/regression/*.parse
    test/golden/regression/*.audio
    test/golden/regression/*.mid
    src/NeoMusic/prelude.neomusic

source-repository head
  type: git
  location: https://github.com/hyperswine/neomusic

common warnings
  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules
    -Wpartial-fields -Wredundant-constraints
  default-language: Haskell2010

common deps
  build-depends:
        base >=4.7 && <5
      , bytestring
      , containers
      , directory
      , filepath
      , parsec
      , process
      , template-haskell
      , temporary
      , vector

library
  import: warnings, deps
  hs-source-dirs: src
  exposed-modules:
        NeoMusic.Audio
      , NeoMusic.Cli
      , NeoMusic.Language
      , NeoMusic.Midi
      , NeoMusic.Numeric
      , NeoMusic.Pitch
      , NeoMusic.Prelude
      , NeoMusic.Recording
      , NeoMusic.Score
      , NeoMusic.Sheet
      , NeoMusic.Signal

executable neo-music
  import: warnings, deps
  main-is: Main.hs
  hs-source-dirs: app/neo-music
  build-depends: neomusic
  ghc-options: -O2

test-suite neomusic-test
  import: warnings, deps
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  hs-source-dirs: test
  other-modules:
      CliTests
    , GoldenTests
    , NeoMusicScoreTests
    , NeoMusicTests
  build-depends: neomusic, hedgehog
  ghc-options: -threaded -rtsopts -with-rtsopts=-N
